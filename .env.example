# ============================================================
# SGU-Notice-RAG 环境变量（复制为 .env 使用）
# 所有服务只从这个文件读配置；不要在代码里写死。
# ============================================================

# ---------- 通用 ----------
APP_ENV=development                # development | production
TZ=Asia/Shanghai

# ---------- C · Go API ----------
API_PORT=8080
JWT_SECRET=dev-change-me-in-production
JWT_TTL_HOURS=12
RAG_CORE_URL=http://rag-core:8000
RAG_TIMEOUT_SECONDS=8

# ---------- A/C/E · PostgreSQL ----------
POSTGRES_URL=postgres://sgu:sgu@postgres:5432/sgu?sslmode=disable
POSTGRES_USER=sgu
POSTGRES_PASSWORD=sgu
POSTGRES_DB=sgu

# ---------- C · Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- A/B · 向量库 ----------
VECTOR_DB_URL=http://qdrant:6333
QDRANT_COLLECTION=sgu_notices

# ---------- B · 模型 ----------
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=20
RAG_STUB_MODE=false                # true: 不加载模型，用确定性假向量跑通链路

# ---------- A · 采集合规（强制项，四道闸门） ----------
# 1) 域白名单：逗号分隔；只接受 sgu.edu.cn 的子集，写别的一律被忽略
SCRAPER_ALLOWED_DOMAINS=sgu.edu.cn
# 2) 请求间隔秒数：下限 1，低于 1 被强制压回 1
SCRAPER_REQUEST_DELAY_SECONDS=1.0
# 3) 单次最多列表页数（不是总请求数！15 条/页）
SCRAPER_MAX_PAGES_PER_RUN=50
# 4) 单次最多 HTTP 请求数（含详情页与重试），硬顶 2000
SCRAPER_MAX_REQUESTS_PER_RUN=800
# 列表页入口（锁定单一栏目，不递归）
SCRAPER_ENTRY_URL=https://www.sgu.edu.cn/jwb/jxtz.htm
SCRAPER_USER_AGENT=SGU-Notice-RAG/dev (student project; contact: team@sgu-notice-rag.local)
# 产出目录
INGESTION_DATA_DIR=ingestion/data

# ---------- D · 前端 ----------
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api

# ---------- E · 评估 ----------
EVAL_DATASET=eval/dataset/queries.jsonl
EVAL_OUTPUT_DIR=eval/report
